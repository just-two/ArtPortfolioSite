---
import Header from '../components/Header.astro';
import { SITE_CONFIG } from '../content.config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = "Tahsin — Portfolio", 
  description = "Art portfolio showcasing oil paintings, still lifes, and studio works.",
  image = "/artwork/twilight-sky.jpg"
} = Astro.props;

// Dynamically resolves site URL for Open Graph tags using Astro config
const siteUrl = import.meta.env.SITE || "http://localhost:4321";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const socialImageUrl = new URL(image, siteUrl).href;
const inquiryEmail = SITE_CONFIG.inquiryEmail; // Global email reference
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / WhatsApp / iMessage / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
  </head>
  <body>
    <Header />
    <main class="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-container">
        <p>© {new Date().getFullYear()} Tahsin. All rights reserved.</p>
        <div class="footer-links">
          <a href={`mailto:${inquiryEmail}`}>Inquiries</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Modern CSS Reset */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html, body {
    height: 100%;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    background-color: #fafafa;
    color: #222222;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .main-content {
    flex: 1;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
  }

  .site-footer {
    padding: 2rem 1.5rem;
    border-top: 1px solid #f0f0f0;
    background-color: #ffffff;
    font-size: 0.875rem;
    color: #777777;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-links a {
    color: #555555;
    text-decoration: none;
  }

  .footer-links a:hover {
    color: #111111;
  }
</style>