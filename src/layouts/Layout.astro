---
import Header from '../components/Header.astro';
import { SITE_CONFIG } from '../content.config';
import headerData from '../data/header.json';
import { getAccentPalette } from '../lib/palette';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = "Tahsin — Portfolio", 
  description = "Art portfolio showcasing oil paintings, still lifes, and studio works.",
  image = "/artwork/twilight-sky.jpg"
} = Astro.props;

// Dynamically resolves site URL for Open Graph tags using Astro config
const siteUrl = import.meta.env.SITE || "http://localhost:4321";
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, ''); // '' for prod, '/dev' for dev
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
// Prefix root-absolute asset paths with the base so OG images resolve under /dev/ too.
const baseAwareImage = image.startsWith('http') ? image : `${baseUrl}${image}`;
const socialImageUrl = new URL(baseAwareImage, siteUrl).href;
const faviconHref = `${baseUrl}/favicon.svg`;
const inquiryEmail = SITE_CONFIG.inquiryEmail; // Global email reference

// Optional banner strip below the nav bar, configured in src/data/header.json.
const banner = headerData.banner;
const bannerEnabled = banner?.enabled === true && Boolean(banner?.image);
const bannerImage = bannerEnabled
  ? (banner.image.startsWith('http') ? banner.image : `${baseUrl}${banner.image}`)
  : '';
const bannerLink = banner?.link
  ? (banner.link.startsWith('http') ? banner.link : `${baseUrl}${banner.link}`)
  : '';
const bannerAlt = banner?.alt ?? '';

// Homepage (gallery) shows a tall hero banner with the nav overlaid; every
// other page shows the shorter 180px strip below the nav.
const isHome = Astro.url.pathname === `${baseUrl}/` || Astro.url.pathname === `${baseUrl}` || Astro.url.pathname === '/';
const heroMode = bannerEnabled && isHome;

// Build-time accent palette derived from the banner image (subtle; neutral
// fallback when the banner is off). Injected as :root CSS custom properties.
const palette = await getAccentPalette();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />

    <!-- Build-time accent palette derived from the banner image -->
    <style set:html={`:root{--accent:${palette.accent};--accent-soft:${palette.accentSoft};--surface-tint:${palette.surfaceTint};--border-tint:${palette.borderTint};--accent-strong:${palette.accentStrong};}`}></style>
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / WhatsApp / iMessage / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
  </head>
  <body>
    {heroMode ? (
      <>
        <div class="banner-hero">
          {bannerLink ? (
            <a href={bannerLink} class="banner-hero-media" aria-label={bannerAlt || 'Banner'}>
              <img src={bannerImage} alt={bannerAlt} width="1600" height="480" />
            </a>
          ) : (
            <div class="banner-hero-media">
              <img src={bannerImage} alt={bannerAlt} width="1600" height="480" />
            </div>
          )}
          <div class="banner-hero-top-fade" aria-hidden="true"></div>
          <Header overlay={true} />
        </div>
        <div class="hero-band">
          <h1 class="hero-band-title">Tahsin Loqman</h1>
          <a href={`${baseUrl}/shop`} class="hero-band-cta">See the collection</a>
        </div>
      </>
    ) : (
      <>
        <Header />
        {bannerEnabled && (
          bannerLink ? (
            <a href={bannerLink} class="site-banner" aria-label={bannerAlt || 'Banner'}>
              <img src={bannerImage} alt={bannerAlt} width="1600" height="180" />
            </a>
          ) : (
            <div class="site-banner">
              <img src={bannerImage} alt={bannerAlt} width="1600" height="180" />
            </div>
          )
        )}
      </>
    )}
    <main class="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-container">
        <p>© {new Date().getFullYear()} Tahsin. All rights reserved.</p>
        <div class="footer-links">
          <a href={`mailto:${inquiryEmail}`}>Inquiries</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Modern CSS Reset */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html, body {
    height: 100%;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    background-color: #fafafa;
    color: #222222;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .main-content {
    flex: 1;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
  }

  /* Full-width banner strip below the nav bar (configured in header.json) */
  .site-banner {
    display: block;
    width: 100%;
    min-height: 180px;
    line-height: 0; /* prevent inline-baseline gap collapsing the anchor */
    overflow: hidden;
    background-color: #f2f2f2;
    border-bottom: 1px solid #f0f0f0;
  }

  .site-banner img {
    width: 100%;
    height: 180px; /* explicit height so the image drives the strip size */
    object-fit: cover;
    display: block;
  }

  @media (max-width: 768px) {
    .site-banner {
      min-height: 120px;
    }

    .site-banner img {
      height: 120px;
    }
  }

  /* Homepage hero banner: full-width image with the nav overlaid on top. */
  .banner-hero {
    position: relative;
    width: 100%;
    min-height: 50vh;
    overflow: hidden;
    background-color: #f2f2f2;
    line-height: 0;
  }

  .banner-hero-media {
    display: block;
    width: 100%;
    height: 50vh;
  }

  .banner-hero-media img {
    display: block;
    width: 100%;
    height: 50vh; /* half the viewport height; image drives the hero size */
    object-fit: cover;
  }

  /* White gradient descending from the top, giving the nav a legible backdrop. */
  .banner-hero-top-fade {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 180px;
    background: linear-gradient(to bottom, #ffffff 0%, rgba(255, 255, 255, 0.6) 45%, rgba(255, 255, 255, 0) 100%);
    pointer-events: none;
    z-index: 2;
  }

  /* Landing hero band: a 240px saturated-accent strip centered on the SCREEN
     (viewport), with the title and CTA sitting snugly inside it. */
  .hero-band {
    position: absolute;
    left: 0;
    right: 0;
    top: 50vh; /* center of the viewport, not the (shorter) banner */
    transform: translateY(-50%);
    height: 240px;
    background: var(--accent-strong, #333333);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
  }

  .hero-band-title {
    margin: 0;
    color: #ffffff;
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    text-align: center;
    white-space: nowrap;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.18);
  }

  .hero-band-cta {
    display: inline-block;
    padding: 0.85rem 1.9rem;
    background: #ffffff;
    color: #111111;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    border-radius: 4px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
    white-space: nowrap;
    transition: box-shadow 0.2s ease;
  }

  .hero-band-cta:hover {
    box-shadow: 0 8px 26px rgba(0, 0, 0, 0.22);
  }

  .site-footer {
    padding: 2rem 1.5rem;
    border-top: 1px solid #f0f0f0;
    background-color: #ffffff;
    font-size: 0.875rem;
    color: #777777;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-links a {
    color: var(--accent, #555555);
    font-weight: 500;
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--accent, #111111);
    filter: brightness(0.8);
  }
</style>