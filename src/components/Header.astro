---
const currentPath = Astro.url.pathname;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="site-header">
  <div class="header-container">
    <a href={`${baseUrl}/`} class="brand-title">Tahsin</a>
    
    <!-- Hamburger Button (Visible on small screens) -->
    <button 
      id="menu-toggle" 
      class="menu-toggle" 
      aria-label="Toggle Navigation Menu" 
      aria-expanded="false"
    >
      <span class="icon-bar"></span>
      <span class="icon-bar"></span>
      <span class="icon-bar"></span>
    </button>

    <!-- Navigation Links -->
    <nav id="site-nav" class="site-nav">
      <a href={`${baseUrl}/`} class:list={[{ active: currentPath === `${baseUrl}/` || currentPath === `${baseUrl}` }]}>Gallery</a>
      <a href={`${baseUrl}/shop`} class:list={[{ active: currentPath.includes('/shop') }]}>Shop</a>
      <a href={`${baseUrl}/about`} class:list={[{ active: currentPath.includes('/about') }]}>About</a>
      <!--<a href={`${baseUrl}/faq`} class:list={[{ active: currentPath.includes('/faq') }]}>FAQ</a>-->
      <a href={`${baseUrl}/subscribe`} class:list={[{ active: currentPath.includes('/subscribe') }]}>Subscribe</a>
    </nav>
  </div>
</header>

<script>
  function initMobileMenu() {
    const toggleBtn = document.getElementById('menu-toggle');
    const nav = document.getElementById('site-nav');

    toggleBtn?.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      toggleBtn.classList.toggle('open');
      nav?.classList.toggle('open');
    });
  }

  // Initialize menu on page load
  initMobileMenu();
</script>

<style>
  .site-header {
    width: 100%;
    padding: 1.5rem 1.5rem;
    border-bottom: 1px solid #f0f0f0;
    background-color: #ffffff;
    position: relative;
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-title {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #111111;
    text-decoration: none;
    z-index: 10;
  }

  /* Desktop Navigation */
  .site-nav {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .site-nav a {
    font-size: 0.95rem;
    color: #666666;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .site-nav a:hover,
  .site-nav a.active {
    color: #111111;
    font-weight: 500;
  }

  /* Hamburger Button Styles */
  .menu-toggle {
    display: none; /* Hidden on desktop */
    flex-direction: column;
    justify-content: space-between;
    width: 24px;
    height: 18px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 10;
  }

  .icon-bar {
    width: 100%;
    height: 2px;
    background-color: #111111;
    border-radius: 2px;
    transition: all 0.25s ease-in-out;
  }

  /* Animated "X" state when menu is open */
  .menu-toggle.open .icon-bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .menu-toggle.open .icon-bar:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle.open .icon-bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* Mobile Responsive Breakpoint (768px) */
  @media (max-width: 768px) {
    .menu-toggle {
      display: flex; /* Show hamburger button */
    }

    .site-nav {
      display: none; /* Hide default inline menu */
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background-color: #ffffff;
      padding: 1.5rem;
      border-bottom: 1px solid #f0f0f0;
      gap: 1.25rem;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
      z-index: 9;
    }

    /* Expand dropdown menu when open */
    .site-nav.open {
      display: flex;
    }

    .site-nav a {
      font-size: 1.05rem;
    }
  }
</style>

<script>
  function setupMobileMenu() {
    const toggleBtn = document.getElementById('menu-toggle');
    const nav = document.getElementById('site-nav');

    if (!toggleBtn || !nav) return;

    // Prevent duplicate listener attachments
    const newToggleBtn = toggleBtn.cloneNode(true);
    toggleBtn.parentNode?.replaceChild(newToggleBtn, toggleBtn);

    newToggleBtn.addEventListener('click', () => {
      const isExpanded = newToggleBtn.getAttribute('aria-expanded') === 'true';
      newToggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      newToggleBtn.classList.toggle('open');
      nav.classList.toggle('open');
    });
  }

  // Runs on initial page load
  setupMobileMenu();

  // Runs after Astro page transitions (View Transitions support)
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>