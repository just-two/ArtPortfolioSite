---
interface SaleOption {
  medium: string;
  price: number;
}

interface Props {
  id: string;
  title: string;
  medium: string;
  year: number;
  image: string;
  forSale?: boolean;
  saleOptions?: SaleOption[];
}

const { id, title, medium, year, image, forSale = false, saleOptions = [] } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Compute starting price if multiple options exist
const minPrice = saleOptions.length > 0 
  ? Math.min(...saleOptions.map(o => o.price)) 
  : null;
---

<article class="art-card">
  <a href={`${baseUrl}/artwork/${id}`}>
    <div class="image-wrapper">
      <img src={`${baseUrl}${image}`} alt={title} loading="lazy" />
      {forSale && <span class="availability-badge">Available</span>}
    </div>
    <div class="card-meta">
      <div class="title-row">
        <h2>{title}</h2>
        {forSale && minPrice !== null && (
          <span class="card-price">
            {saleOptions.length > 1 ? `From $${minPrice}` : `$${minPrice}`}
          </span>
        )}
      </div>
      <p>{medium} • {year}</p>
    </div>
  </a>
</article>

<style>
  .art-card {
    display: flex;
    flex-direction: column;
  }

  .art-card a {
    text-decoration: none;
    color: inherit;
  }

  .image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: #f2f2f2;
    border-radius: 4px;
  }

  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .art-card a:hover .image-wrapper img {
    transform: scale(1.03);
  }

  .availability-badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    padding: 0.25rem 0.6rem;
    background-color: rgba(17, 17, 17, 0.85);
    color: #ffffff;
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    border-radius: 3px;
    backdrop-filter: blur(4px);
  }

  .card-meta {
    margin-top: 0.75rem;
  }

  .title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .card-meta h2 {
    font-size: 1.05rem;
    font-weight: 500;
    color: #111111;
  }

  .card-price {
    font-size: 0.95rem;
    font-weight: 500;
    color: #111111;
  }

  .card-meta p {
    font-size: 0.875rem;
    color: #666666;
    margin-top: 0.15rem;
  }
</style>