---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../content.config';
import { commerceEnabled } from '../../lib/features';

export async function getStaticPaths() {
  const paintings = await getCollection('paintings');
  return paintings.map((entry) => ({
    params: { id: entry.id },
    props: { painting: entry.data },
  }));
}

const { painting } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const inquiryEmail = SITE_CONFIG?.inquiryEmail || 'tahsinloqman@gmail.com';

const isDev = import.meta.env.DEV;
---

<Layout 
  title={`${painting.title} — Tahsin`}
  description={`${painting.title} (${painting.year}). ${painting.medium}, ${painting.dimensions}.`}
  image={painting.image}
>
  <div class="detail-container">
    <a href={`${baseUrl}/`} class="back-link">← Back to Gallery</a>

    <div class="detail-grid">
      <div class="artwork-display">
        <img src={`${baseUrl}${painting.image}`} alt={painting.title} />
      </div>

      <div class="artwork-info">
        <h1>{painting.title}</h1>
        
        <dl class="specs">
          <div>
            <dt>Medium</dt>
            <dd>{painting.medium}</dd>
          </div>
          <div>
            <dt>Dimensions</dt>
            <dd>{painting.dimensions}</dd>
          </div>
          <div>
            <dt>Year</dt>
            <dd>{painting.year}</dd>
          </div>
        </dl>

        {painting.description && (
          <div class="description">
            <h2>Notes</h2>
            <p>{painting.description}</p>
          </div>
        )}

        <div class="purchase-box">
          {painting.for_sale && painting.sale_options && painting.sale_options.length > 0 ? (
            <div class="purchase-container">
              <h3 class="purchase-title">
                {commerceEnabled ? 'Purchase Options' : 'Available'} {isDev && <span class="dev-badge">(Dev Mode)</span>}
              </h3>
              
              <div class="options-list">
                {painting.sale_options.map((option) => {
                  // Fallback to dummy link (#) in development mode if no real checkout_url exists
                  const href = isDev ? (option.checkout_url || "#") : option.checkout_url;

                  // When commerce is disabled via feature flag, every option becomes an
                  // "Inquire" mailto action instead of a Stripe checkout link.
                  const inquiryHref = `mailto:${inquiryEmail}?subject=${encodeURIComponent(`Inquiry: ${painting.title} — ${option.medium}`)}`;

                  return (
                    <div class="option-card">
                      <div class="option-details">
                        <span class="option-medium">{option.medium}</span>
                        <span class="option-price">${option.price} USD</span>
                      </div>

                      {commerceEnabled ? (
                        href && (
                          <a 
                            href={href} 
                            class="buy-button" 
                            target={isDev && href === "#" ? "_self" : "_blank"} 
                            rel="noopener noreferrer"
                            onClick={isDev && href === "#" ? "event.preventDefault(); alert('Dev Mode: Checkout disabled.');" : undefined}
                          >
                            Buy Now
                          </a>
                        )
                      ) : (
                        <a href={inquiryHref} class="buy-button">
                          Inquire
                        </a>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>
          ) : (
            <div class="sale-status private-collection">
              <span class="status-text">Private Collection / Sold</span>
              <a 
                href={`mailto:${inquiryEmail}?subject=${encodeURIComponent(`Inquiry: ${painting.title}`)}`} 
                class="inquiry-button secondary"
              >
                Inquire About Future Prints or Commissions
              </a>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .detail-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: #666666;
    text-decoration: none;
    font-size: 0.95rem;
  }

  .back-link:hover {
    color: #111111;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3.5rem;
    align-items: start;
  }

  @media (max-width: 768px) {
    .detail-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .artwork-display img {
    width: 100%;
    height: auto;
    border-radius: 4px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }

  .artwork-info h1 {
    font-size: 2.25rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  .specs {
    display: grid;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #f0f0f0;
  }

  .specs dt {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #888888;
  }

  .specs dd {
    font-size: 1.05rem;
    color: #222222;
  }

  .description {
    margin-top: 1.5rem;
  }

  .description h2 {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #888888;
    margin-bottom: 0.5rem;
  }

  .description p {
    color: #444444;
  }

  .purchase-box {
    margin-top: 2.5rem;
    padding: 1.5rem;
    border: 1px solid #ebebeb;
    border-radius: 6px;
    background-color: #ffffff;
  }

  .sale-options-list h2 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #888888;
    margin-bottom: 1rem;
  }

  .option-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 0;
    border-bottom: 1px solid #f0f0f0;
  }

  .option-row:last-child {
    border-bottom: none;
  }

  .option-details {
    display: flex;
    flex-direction: column;
  }

  .option-medium {
    font-size: 1rem;
    font-weight: 500;
    color: #111111;
  }

  .option-price {
    font-size: 0.9rem;
    color: #666666;
  }

  .inquiry-button {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    background-color: #111111;
    color: #ffffff;
    text-decoration: none;
    border-radius: 4px;
    font-size: 0.875rem;
    transition: background-color 0.2s ease;
  }

  .inquiry-button:hover {
    background-color: #333333;
  }

  .inquiry-button.secondary {
    display: block;
    text-align: center;
    padding: 0.75rem 1rem;
    background-color: #f5f5f5;
    color: #333333;
    border: 1px solid #e0e0e0;
  }

  .purchase-container {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid #f0f0f0;
  }

  .purchase-title {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #888888;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dev-badge {
    background-color: #fff3cd;
    color: #856404;
    font-size: 0.75rem;
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    text-transform: none;
  }

  .options-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .option-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem;
    background-color: #ffffff;
    border: 1px solid #e5e5e5;
    border-radius: 6px;
    gap: 1rem;
  }

  .option-details {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .option-medium {
    font-size: 0.95rem;
    font-weight: 500;
    color: #111111;
  }

  .option-price {
    font-size: 0.875rem;
    color: #666666;
  }

  .buy-button {
    display: inline-block;
    padding: 0.55rem 1.15rem;
    background-color: var(--accent, #111111);
    color: #ffffff !important;
    text-decoration: none !important;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 4px;
    white-space: nowrap;
    transition: background-color 0.2s ease;
  }

  .buy-button:hover {
    background-color: var(--accent, #333333);
    filter: brightness(0.92);
    color: #ffffff !important;
  }

  .buy-button:visited {
    color: #ffffff !important;
  }

  @media (max-width: 480px) {
    .option-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .buy-button {
      width: 100%;
      text-align: center;
    }
  }
</style>