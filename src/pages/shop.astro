---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ArtCard from '../components/ArtCard.astro';
import MailingListModal from '../components/MailingListModal.astro';
import { SITE_CONFIG } from '../content.config';
import { mailingListEnabled } from '../lib/features';

const allPaintings = await getCollection('paintings');
const availableWorks = allPaintings.filter((piece) => piece.data.for_sale);
const inquiryEmail = SITE_CONFIG.inquiryEmail; // Global email reference
---

<Layout 
  title="Available Works — Tahsin" 
  description="Original oil paintings and prints available for purchase directly from the studio."
>
  <main class="shop-container">
    <section class="shop-header">
      <h1>Available Works</h1>
      <p>Original oil paintings and limited releases available directly from the studio.</p>
    </section>

    {availableWorks.length > 0 ? (
      <div class="shop-grid">
        {availableWorks.map((piece) => (
          <ArtCard
            id={piece.id}
            title={piece.data.title}
            medium={piece.data.medium}
            displayMedium={piece.data.sale_options?.[0]?.medium}
            year={piece.data.year}
            image={piece.data.image}
            forSale={piece.data.for_sale}
            saleOptions={piece.data.sale_options}
            showDetails={true}
            uniform={true}
          />
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>There are currently no original pieces or prints available for immediate purchase.</p>
        <a href={`mailto:${inquiryEmail}`} class="commission-link">
          Inquire about upcoming works or commissions →
        </a>
      </div>
    )}
  </main>

  {mailingListEnabled && <MailingListModal />}
</Layout>

<style>
  .shop-container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem 1rem;
    box-sizing: border-box;
  }

  .shop-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #f0f0f0;
  }

  .shop-header h1 {
    font-size: 2rem;
    font-weight: 500;
    margin-bottom: 0.35rem;
    letter-spacing: -0.02em;
  }

  .shop-header p {
    color: #666666;
    font-size: 1.05rem;
  }

  /* Responsive multi-column uniform grid */
  .shop-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 2.5rem 1.5rem;
    width: 100%;
  }

  .empty-state {
    padding: 4rem 1rem;
    text-align: center;
    background-color: #ffffff;
    border: 1px dashed #e0e0e0;
    border-radius: 6px;
  }

  .empty-state p {
    color: #666666;
    font-size: 1.1rem;
    margin-bottom: 1rem;
  }

  .commission-link {
    color: #111111;
    font-weight: 500;
    text-decoration: none;
  }

  .commission-link:hover {
    text-decoration: underline;
  }
</style>