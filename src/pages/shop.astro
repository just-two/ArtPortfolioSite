---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ArtCard from '../components/ArtCard.astro';

const allPaintings = await getCollection('paintings');
const availableWorks = allPaintings.filter((piece) => piece.data.for_sale);
---

<Layout 
  title="Available Works — Tahsin" 
  description="Original oil paintings and studies available for purchase directly from the studio."
>
  <section class="shop-header">
    <h1>Available Works</h1>
    <p>Original oil paintings and studies currently available directly from the studio.</p>
  </section>

  {availableWorks.length > 0 ? (
    <section class="gallery-grid">
      {availableWorks.map((piece) => (
        <ArtCard
          id={piece.id}
          title={piece.data.title}
          medium={piece.data.medium}
          displayMedium={piece.data.sale_medium}
          year={piece.data.year}
          image={piece.data.image}
          forSale={piece.data.for_sale}
          price={piece.data.price}
        />
      ))}
    </section>
  ) : (
    <div class="empty-state">
      <p>There are currently no original pieces available for immediate purchase.</p>
      <a href="mailto:contact@yourdomain.com" class="commission-link">
        Inquire about upcoming works or commissions →
      </a>
    </div>
  )}
</Layout>

<style>
  .shop-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #f0f0f0;
  }

  .shop-header h1 {
    font-size: 2rem;
    font-weight: 500;
    margin-bottom: 0.35rem;
    letter-spacing: -0.02em;
  }

  .shop-header p {
    color: #666666;
    font-size: 1.05rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2.5rem 2rem;
  }

  .empty-state {
    padding: 4rem 1rem;
    text-align: center;
    background-color: #ffffff;
    border: 1px dashed #e0e0e0;
    border-radius: 6px;
  }

  .empty-state p {
    color: #666666;
    font-size: 1.1rem;
    margin-bottom: 1rem;
  }

  .commission-link {
    color: #111111;
    font-weight: 500;
    text-decoration: none;
  }

  .commission-link:hover {
    text-decoration: underline;
  }
</style>