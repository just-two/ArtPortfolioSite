---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ArtCard from '../components/ArtCard.astro';

const paintings = await getCollection('paintings');
---

<Layout title="Gallery — Tahsin">
  <main class="gallery-container">
    <div class="gallery-masonry">
      {paintings.map((piece) => (
        <div class="masonry-item">
          <ArtCard
            id={piece.id}
            title={piece.data.title}
            image={piece.data.image}
            forSale={false}
            showDetails={false}
            uniform={false}
          />
        </div>
      ))}
    </div>
  </main>
</Layout>

<style>
  .gallery-container {
    max-width: 1400px;
    margin: -60px auto 0; /* overlap upward into the hero's bottom fade (landing page only) */
    padding: 1rem;
    position: relative;
    z-index: 3; /* sit above the hero fades (z-index 2) so the grid appears to start before the hero ends */
  }

  .gallery-masonry {
    column-count: 3;
    column-gap: 0.75rem; /* Tighter horizontal margin between columns */
    width: 100%;
  }

  .masonry-item {
    break-inside: avoid;
    margin-bottom: 0.75rem; /* Tighter vertical margin between items */
  }

  @media (max-width: 900px) {
    .gallery-masonry {
      column-count: 2;
      column-gap: 0.75rem;
    }
  }

  @media (max-width: 500px) {
    .gallery-masonry {
      column-count: 1;
    }
  }
</style>