---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ArtCard from '../components/ArtCard.astro';
import MailingListModal from '../components/MailingListModal.astro';

const paintings = await getCollection('paintings');
---

<Layout title="Tahsin — Selected Works">
  <section class="intro-section">
    <h1>Selected Artwork</h1>
    <p>Oil paintings, floral studies, and still life compositions.</p>
  </section>

  <section class="gallery-grid">
    {paintings.map((piece) => (
      <ArtCard
        id={piece.id}
        title={piece.data.title}
        medium={piece.data.medium}
        year={piece.data.year}
        image={piece.data.image}
      />
    ))}
  </section>

  <!-- Popup component renders silently until scroll triggers -->
  <MailingListModal />
</Layout>

<style>
  .intro-section {
    margin-bottom: 2.5rem;
  }

  .intro-section h1 {
    font-size: 2rem;
    font-weight: 500;
    margin-bottom: 0.25rem;
  }

  .intro-section p {
    color: #666666;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2.5rem 2rem;
  }
</style>