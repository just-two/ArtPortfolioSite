---
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../config';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const inquiryEmail = SITE_CONFIG.inquiryEmail; // Global email reference
---

<Layout title="About — Tahsin" description="Bio, artist statement, and contact information for Tahsin.">
  <div class="about-container">
    <header class="about-header">
      <h1>About the Artist</h1>
    </header>

    <div class="about-grid">
      <div class="artist-portrait">
        <!-- Replace with your studio/portrait photo or artwork detail -->
        <img src={`${baseUrl}/artwork/artist-portrait.jpg`} alt="Tahsin in the studio" />
      </div>

      <div class="about-content">
        <section class="bio-section">
          <h2>Biography</h2>
          <p>
            Tahsin is an oil painter based in Boston, Massachusetts. Working primarily from life, her work explores quiet still lifes, botanical studies, and subtle atmospheric light.
          </p>
          <p>
            Drawing from classical observational methods and painterly textures, each piece focuses on capturing form, color relationships, and the quiet dignity of everyday objects.
          </p>
        </section>

        <section class="details-section">
          <div class="detail-block">
            <h3>Focus & Mediums</h3>
            <p>Oil on canvas, panel, and linen; still life, floral, and landscape compositions.</p>
          </div>

          <div class="detail-block">
            <h3>Inquiries & Commissions</h3>
            <p>For purchasing available works, exhibition inquiries, or private commissions, please reach out via email.</p>
            <a href={`mailto:${inquiryEmail}`} class="contact-button">Send an Inquiry</a>
          </div>
        </section>
      </div>
    </div>
  </div>
</Layout>

<style>
  .about-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .about-header {
    margin-bottom: 2.5rem;
  }

  .about-header h1 {
    font-size: 2.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: #111111;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 3.5rem;
    align-items: start;
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .artist-portrait img {
    width: 100%;
    height: auto;
    border-radius: 4px;
    background-color: #f2f2f2;
    object-fit: cover;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .bio-section h2 {
    font-size: 1.1rem;
    font-weight: 500;
    color: #111111;
    margin-bottom: 0.75rem;
  }

  .bio-section p {
    color: #444444;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .bio-section p:last-child {
    margin-bottom: 0;
  }

  .details-section {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid #f0f0f0;
  }

  .detail-block h3 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #888888;
    margin-bottom: 0.35rem;
  }

  .detail-block p {
    color: #444444;
    font-size: 0.95rem;
  }

  .contact-button {
    display: inline-block;
    margin-top: 0.85rem;
    padding: 0.75rem 1.5rem;
    background-color: #111111;
    color: #ffffff;
    text-decoration: none;
    border-radius: 4px;
    font-size: 0.9rem;
    transition: background-color 0.2s ease;
  }

  .contact-button:hover {
    background-color: #333333;
  }
</style>